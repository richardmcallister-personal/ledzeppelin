{
  "name": "ledzeppelin",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ledzeppelin.app", "custom_domain": true },
    { "pattern": "www.ledzeppelin.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "LZ_CACHE", "id": "48acfb106e344cdd8cbb0e5f51c9b65c" }
  ],
  "observability": { "enabled": true }
}
